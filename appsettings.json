{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LogisticDesk",
    "Audience": "LogisticDesk",
    "AccessTokenExpirationMinutes": 30
    // "SigningKey" is a secret: set it with `dotnet user-secrets set "Jwt:SigningKey" "<random 32+ chars>"`
    // locally, or the Jwt__SigningKey environment variable in Docker and Azure.
  },
  "Identity": {
    "RequireConfirmedEmail": false
  }

}
